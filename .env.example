# BasketLab — Environment Variables
# Copy this file to .env (local dev) or set them in the Vercel project (web) and in the GitHub Actions secrets (jobs).
# .env is gitignored and should never be committed. There is no API server (it was retired, epic #1199).

# ── Jobs and scripts (Python) ────────────────────────────────────────────────

# MongoDB connection string. Locally, a Mongo of your own (the games come from the private archive: `python run_archive.py pull` + `load`);
# without it, src/database/db_credentials.txt is read.
MONGODB_CONNECTION_STRING=mongodb://localhost:27017

# Deployment environment: "development" | "production" (src/database/db_config.py)
ENVIRONMENT=development

# ── Web (Vite / React) ───────────────────────────────────────────────────────
# Where the web reads the data published by the refresh (branch `web-data`, issues #328, #640): the only source of its data.
# Leave empty to use https://raw.githubusercontent.com/kanijoman/BasketLab/web-data/ ; to move to another host, publish the same files there and set it here.
VITE_DATA_BASE=
