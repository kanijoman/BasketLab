# BasketLab — Environment Variables
# Copy this file to .env (local dev) or configure directly in Render / Vercel.
# .env is gitignored and should never be committed.

# ── Backend (FastAPI + Python) ───────────────────────────────────────────────

# MongoDB Atlas connection string (required in production)
MONGODB_CONNECTION_STRING=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/BASKETBALL?retryWrites=true&w=majority

# Deployment environment: "development" | "production"
# Set to "production" on Render. Locally, leave unset or "development".
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS (required in production)
# Example: https://basketlab.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=http://localhost:5173

# Set to "1" to enable hot-reload in local dev
BASKETLAB_DEV=0

# ── AI providers (optional — only needed for AI analysis features) ──────────
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=gsk_...

# ── Frontend (Vite / React) ──────────────────────────────────────────────────
# Base URL of the backend API, used at build time by Vite.
# Leave empty in local dev (Vite proxy handles /api/* → localhost:8000).
# Set to the Render URL in Vercel environment variables:
#   VITE_API_BASE=https://basketlab-api.onrender.com
VITE_API_BASE=

# URL of the dedicated scraper service (separate Render instance, no ML deps).
# Leave empty in local dev — falls back to VITE_API_BASE so a single backend works.
# Set in Vercel environment variables after creating the scraper service on Render:
#   VITE_SCRAPER_BASE=https://basketlab-scraper.onrender.com
VITE_SCRAPER_BASE=
