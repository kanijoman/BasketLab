# BasketLab — Environment Variables
# Copy this file to .env (local dev) or configure directly in the hosting of the web (Vercel) or of the API, if you run one.
# .env is gitignored and should never be committed.

# ── Backend (FastAPI + Python) ───────────────────────────────────────────────

# MongoDB connection string (required in production). Locally, a Mongo of your own (the games come from the private archive: `python run_archive.py pull` + `load`)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017

# Deployment environment: "development" | "production"
# Set to "production" where the API is served for real. Locally, leave unset or "development".
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS (required in production)
# Example: https://basketlab.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=http://localhost:5173

# Admin API key: protects DELETE collections, scrape, historical ingest and model training
# (sent as the X-Admin-Key header; the Admin page asks for it). Required in production
# (the endpoints answer 503 without it); optional locally (open when unset).
ADMIN_API_KEY=

# Set to "1" to enable hot-reload in local dev
BASKETLAB_DEV=0

# ── Frontend (Vite / React) ──────────────────────────────────────────────────
# Base URL of the backend API, used at build time by Vite.
# Leave empty in local dev (Vite proxy handles /api/* → localhost:8000).
# Only the fallback of the web reads the API (the default source is the published files): set it to the URL of an API you host, in the Vercel environment variables.
VITE_API_BASE=

# Where the web reads the data published by the refresh (branch `web-data`, issues #328, #640). Only with ?data=local.
# Leave empty to use https://raw.githubusercontent.com/kanijoman/BasketLab/web-data/ ; to move to another host, publish the same files there and set it here.
VITE_DATA_BASE=
